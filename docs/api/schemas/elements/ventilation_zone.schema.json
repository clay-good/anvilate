{
  "$defs": {
    "Quantity": {
      "description": "A physical value: a magnitude and the unit it was expressed in.\n\nConstruct directly (``Quantity(magnitude=75, unit=\"kip\")``) or parse from\ntext (``Quantity.parse(\"75 kip\")``). The stored ``unit`` string is exactly\nwhat the user wrote, canonicalized only to Pint's spelling of it.",
      "properties": {
        "magnitude": {
          "title": "Magnitude",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "magnitude",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    }
  },
  "$id": "https://anvilate.dev/schemas/elements/ventilation_zone/1.0.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Anvilate pack element 'ventilation_zone': the fields a Design Spec puts in `element_params` when it declares `element_type: ventilation_zone`. Generated from anvilate.packs.ventilation.VentilationZone.",
  "properties": {
    "area_outdoor_rate": {
      "$ref": "#/$defs/Quantity"
    },
    "floor_area": {
