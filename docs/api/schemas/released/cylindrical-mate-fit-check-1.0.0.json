          "title": "Maximum Diameter Mm",
          "type": "number"
        },
        "measured_diameter_mm": {
          "exclusiveMinimum": 0,
          "title": "Measured Diameter Mm",
          "type": "number"
        },
        "minimum_diameter_mm": {
          "exclusiveMinimum": 0,
          "title": "Minimum Diameter Mm",
          "type": "number"
        },
        "within_zone": {
          "title": "Within Zone",
          "type": "boolean"
        }
      },
      "required": [
        "designation",
        "measured_diameter_mm",
        "minimum_diameter_mm",
        "maximum_diameter_mm",
        "within_zone"
      ],
      "title": "FitFeatureCheck",
      "type": "object"
    }
