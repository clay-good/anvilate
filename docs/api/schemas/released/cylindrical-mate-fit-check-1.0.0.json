  "$id": "https://anvilate.dev/schemas/cylindrical-mate-fit-check/1.0.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Anvilate cylindrical mate fit check: a confirmed measured bore/shaft pair checked against caller-supplied ISO 286 basic size and designations, with feature limits, per-feature verdicts, clearance range, and citation. Generated from anvilate.geometry.CylindricalMateFitCheck.",
  "properties": {
    "basic_size_mm": {
      "exclusiveMinimum": 0,
      "title": "Basic Size Mm",
      "type": "number"
    },
    "confirmed_mate": {
      "$ref": "#/$defs/ConfirmedCylindricalMate"
    },
    "fit_designation": {
      "title": "Fit Designation",
      "type": "string"
    },
    "fit_kind": {
      "enum": [
        "clearance",
        "transition",
        "interference"
      ],
      "title": "Fit Kind",
      "type": "string"
    },
    "hole": {
      "$ref": "#/$defs/FitFeatureCheck"
    },
    "maximum_design_clearance_mm": {
      "title": "Maximum Design Clearance Mm",
      "type": "number"
    },
    "measured_clearance_within_design_range": {
      "title": "Measured Clearance Within Design Range",
      "type": "boolean"
    },
    "minimum_design_clearance_mm": {
      "title": "Minimum Design Clearance Mm",
      "type": "number"
    },
    "reference": {
      "title": "Reference",
      "type": "string"
    },
    "shaft": {
      "$ref": "#/$defs/FitFeatureCheck"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "confirmed_mate",
    "basic_size_mm",
    "fit_designation",
    "fit_kind",
    "minimum_design_clearance_mm",
    "maximum_design_clearance_mm",
    "hole",
    "shaft",
    "measured_clearance_within_design_range",
    "status",
    "reference"
  ],
  "title": "CylindricalMateFitCheck",
  "type": "object",
  "x-anvilate-version": "1.0.0"
}
