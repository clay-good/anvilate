        },
        "axis_direction": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Axis Direction",
          "type": "array"
        },
        "axis_origin_mm": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Axis Origin Mm",
          "type": "array"
        },
        "bore_diameter_mm": {
          "exclusiveMinimum": 0,
          "title": "Bore Diameter Mm",
          "type": "number"
        },
        "bore_solid_id": {
          "title": "Bore Solid Id",
          "type": "string"
        },
        "bore_surface_id": {
          "title": "Bore Surface Id",
          "type": "string"
        },
        "confirmed_by": {
          "title": "Confirmed By",
          "type": "string"
        },
        "diametral_clearance_mm": {
          "title": "Diametral Clearance Mm",
          "type": "number"
        },
        "mate_candidate_id": {
          "title": "Mate Candidate Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "shaft_diameter_mm": {
          "exclusiveMinimum": 0,
          "title": "Shaft Diameter Mm",
          "type": "number"
        },
        "shaft_solid_id": {
          "title": "Shaft Solid Id",
          "type": "string"
        },
        "shaft_surface_id": {
          "title": "Shaft Surface Id",
          "type": "string"
        },
        "source_name": {
          "title": "Source Name",
          "type": "string"
