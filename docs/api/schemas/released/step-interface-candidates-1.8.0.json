{
  "$defs": {
    "CheckStatus": {
      "description": "A check's outcome.\n\n``NOT_EVALUATED`` is never silently treated as a pass — a check that could\nnot run is reported as such. ``OVER_MARGIN`` is a passing check whose margin\nran past a declared upper band: acceptable, never blocking, but flagged so an\nover-engineered candidate is as visible as a failing one.",
      "enum": [
        "pass",
        "fail",
        "over_margin",
        "not_evaluated"
      ],
      "title": "CheckStatus",
      "type": "string"
    },
    "CircularFeatureCandidate": {
      "description": "One concentric bore, boss, or counterbore that can locate a mating interface.",
      "properties": {
        "axial_extent_mm": {
          "exclusiveMinimum": 0,
          "title": "Axial Extent Mm",
          "type": "number"
        },
        "center_mm": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Center Mm",
          "type": "array"
        },
        "diameter_mm": {
          "exclusiveMinimum": 0,
          "title": "Diameter Mm",
          "type": "number"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "bore",
            "boss",
            "counterbore"
          ],
          "title": "Kind",
          "type": "string"
        },
        "through_diameter_mm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Through Diameter Mm"
        }
      },
      "required": [
        "id",
        "kind",
        "diameter_mm",
        "axial_extent_mm",
        "center_mm"
      ],
      "title": "CircularFeatureCandidate",
      "type": "object"
    },
    "Comparison": {
      "description": "What a check measured, what it was judged against, and which way passes.\n\nA check that compares two quantities used to state the comparison as a *sentence*,\nwritten at screening time. A screen does not know what unit system its result will be\nread in, so a US-customary report printed a deflection verdict in millimetres directly\nbeneath a worked derivation in inches — same check, same page, two systems.\n\nThe numbers travel instead, and the sentence is rendered by whoever is showing it. That\nis the shape :meth:`ScorecardEntry.from_safety_factor` has always had: it writes its\nline from the two factors rather than taking one from its caller, which is why the\nsafety-factor half of the library never had this defect.\n\n``minimum_decimals`` is the precision floor the sentence starts from; it widens from\nthere until the two figures are distinguishable, because a FAIL reading \"15.000 mm vs\nlimit 15.000 mm\" states the opposite of its own verdict.",
      "properties": {
        "limit": {
          "$ref": "#/$defs/Quantity"
        },
        "limit_label": {
          "title": "Limit Label",
          "type": "string"
        },
        "measured": {
          "$ref": "#/$defs/Quantity"
        },
        "measured_label": {
          "title": "Measured Label",
          "type": "string"
        },
        "minimum_decimals": {
          "default": 3,
          "title": "Minimum Decimals",
          "type": "integer"
        },
        "sense": {
          "$ref": "#/$defs/LimitSense"
        }
      },
      "required": [
        "measured",
        "limit",
        "sense",
        "measured_label",
        "limit_label"
      ],
      "title": "Comparison",
      "type": "object"
    },
