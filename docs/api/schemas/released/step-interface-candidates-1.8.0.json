    "RepairHint": {
      "description": "How to move a failing check back into bounds.\n\nA failed check computes this deterministically — never an LLM guess. It names\nthe governing spec ``parameter`` by its stable name and the ``direction`` that\nimproves the margin. When a paired design inverse exists, ``corrective_value``\n(in ``unit``) is the value of that parameter which satisfies the check at the\nrequired margin — turning repair from a search into a single solve. Without an\ninverse the value is ``None``: a direction is still honest, an invented number\nis not. ``provenance`` records where the hint came from (the inverse function,\nor a monotonicity declaration).",
      "properties": {
        "corrective_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corrective Value"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "parameter": {
          "title": "Parameter",
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provenance"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "parameter",
        "direction"
      ],
      "title": "RepairHint",
      "type": "object"
    },
    "Scorecard": {
      "description": "A collection of check entries with a rolled-up overall status.\n\nThe roll-up honours No-silent-green: the scorecard :attr:`status` is ``FAIL``\nif any check failed, else ``NOT_EVALUATED`` if any check could not run (or\nthere are no checks at all), else ``OVER_MARGIN`` if any check passed above\nits band, and only ``PASS`` when every check ran and passed cleanly. So\n:attr:`passed` is never true while a check is unevaluated, and an\nover-engineered card is visible without being blocked.",
      "properties": {
        "entries": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ScorecardEntry"
          },
          "title": "Entries",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/CheckStatus",
          "readOnly": true
        }
      },
      "required": [
        "status"
      ],
      "title": "Scorecard",
      "type": "object"
    },
