    "MarginUncertainty": {
      "description": "A sampled margin: the chance it falls short, its band, and what drives it.\n\n``shortfall_probability`` is the fraction of samples whose response fell below\n``required`` — the number a nominal pass can hide. ``lower`` and ``upper`` bound\nthe central ``coverage`` fraction of the sampled response. ``sensitivities``\nranks the inputs by their first-order share of the response variance, largest\nfirst. Everything is reproducible from ``seed``.",
      "properties": {
        "citation": {
          "default": "Monte Carlo propagation of input distributions; first-order (Taylor) variance sensitivity. Screening only — not a certified reliability analysis.",
          "title": "Citation",
          "type": "string"
        },
        "coverage": {
          "title": "Coverage",
          "type": "number"
        },
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "mean": {
          "title": "Mean",
          "type": "number"
        },
        "method": {
          "const": "monte_carlo",
          "default": "monte_carlo",
          "title": "Method",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "number"
        },
        "samples": {
          "title": "Samples",
          "type": "integer"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "sensitivities": {
          "items": {
            "$ref": "#/$defs/Sensitivity"
          },
          "title": "Sensitivities",
          "type": "array"
        },
        "shortfall_probability": {
          "title": "Shortfall Probability",
          "type": "number"
        },
        "std": {
          "title": "Std",
          "type": "number"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "samples",
        "seed",
        "required",
        "mean",
        "std",
        "shortfall_probability",
        "lower",
        "upper",
        "coverage",
        "sensitivities"
      ],
      "title": "MarginUncertainty",
      "type": "object"
    },
