{
  "$defs": {
    "Quantity": {
      "description": "A physical value: a magnitude and the unit it was expressed in.\n\nConstruct directly (``Quantity(magnitude=75, unit=\"kip\")``) or parse from\ntext (``Quantity.parse(\"75 kip\")``). The stored ``unit`` string is exactly\nwhat the user wrote, canonicalized only to Pint's spelling of it.",
      "properties": {
        "magnitude": {
          "title": "Magnitude",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "magnitude",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    }
  },
  "$id": "https://anvilate.dev/schemas/elements/bolted_connection/1.1.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Anvilate pack element 'bolted_connection': the fields a Design Spec puts in `element_params` when it declares `element_type: bolted_connection`. Generated from anvilate.packs.structural.BoltedConnection.",
  "properties": {
    "bolt_diameter": {
      "$ref": "#/$defs/Quantity"
    },
    "bolt_material": {
      "title": "Bolt Material",
      "type": "string"
    },
    "edge_distance": {
      "anyOf": [
        {
          "$ref": "#/$defs/Quantity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "load": {
      "$ref": "#/$defs/Quantity"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "plate_material": {
      "title": "Plate Material",
      "type": "string"
    },
    "plate_thickness": {
      "$ref": "#/$defs/Quantity"
    },
    "shear_planes": {
      "default": 1,
      "title": "Shear Planes",
      "type": "integer"
    },
    "signed_fields": {
      "default": [
        "load",
        "tension"
      ],
      "items": {
        "type": "string"
      },
      "title": "Signed Fields",
      "type": "array"
    },
    "tension": {
      "anyOf": [
        {
          "$ref": "#/$defs/Quantity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "name",
    "bolt_diameter",
    "plate_thickness",
    "load",
    "bolt_material",
    "plate_material"
  ],
  "title": "BoltedConnection",
  "type": "object",
  "x-anvilate-version": "1.1.0"
}
