{
  "$defs": {
    "Quantity": {
      "description": "A physical value: a magnitude and the unit it was expressed in.\n\nConstruct directly (``Quantity(magnitude=75, unit=\"kip\")``) or parse from\ntext (``Quantity.parse(\"75 kip\")``). The stored ``unit`` string is exactly\nwhat the user wrote, canonicalized only to Pint's spelling of it.",
      "properties": {
        "magnitude": {
          "title": "Magnitude",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "magnitude",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    }
  },
  "$id": "https://anvilate.dev/schemas/elements/infinite_slope/1.1.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Anvilate pack element 'infinite_slope': the fields a Design Spec puts in `element_params` when it declares `element_type: infinite_slope`. Generated from anvilate.packs.geotechnical.InfiniteSlope.",
  "properties": {
    "cohesion": {
      "$ref": "#/$defs/Quantity"
    },
    "depth": {
      "$ref": "#/$defs/Quantity"
    },
    "friction_angle": {
      "title": "Friction Angle",
      "type": "number"
    },
    "pore_pressure": {
      "anyOf": [
        {
          "$ref": "#/$defs/Quantity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "signed_fields": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Signed Fields",
      "type": "array"
    },
    "slope_angle": {
      "title": "Slope Angle",
      "type": "number"
    },
    "unit_weight": {
      "$ref": "#/$defs/Quantity"
    }
  },
  "required": [
    "cohesion",
    "friction_angle",
    "unit_weight",
    "depth",
    "slope_angle"
  ],
  "title": "InfiniteSlope",
  "type": "object",
  "x-anvilate-version": "1.1.0"
}
