{
  "$defs": {
    "Quantity": {
      "description": "A physical value: a magnitude and the unit it was expressed in.\n\nConstruct directly (``Quantity(magnitude=75, unit=\"kip\")``) or parse from\ntext (``Quantity.parse(\"75 kip\")``). The stored ``unit`` string is exactly\nwhat the user wrote, canonicalized only to Pint's spelling of it.",
      "properties": {
        "magnitude": {
          "title": "Magnitude",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "magnitude",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    }
  },
  "$id": "https://anvilate.dev/schemas/elements/base_plate/1.1.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Anvilate pack element 'base_plate': the fields a Design Spec puts in `element_params` when it declares `element_type: base_plate`. Generated from anvilate.packs.structural.BasePlate.",
  "properties": {
    "axial_load": {
      "$ref": "#/$defs/Quantity"
    },
    "cantilever": {
      "anyOf": [
        {
          "$ref": "#/$defs/Quantity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "concrete_strength": {
      "$ref": "#/$defs/Quantity"
    },
    "depth": {
      "$ref": "#/$defs/Quantity"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "plate_material": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plate Material"
    },
    "plate_thickness": {
      "anyOf": [
        {
          "$ref": "#/$defs/Quantity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "signed_fields": {
      "default": [
        "axial_load"
      ],
      "items": {
        "type": "string"
      },
      "title": "Signed Fields",
      "type": "array"
    },
    "width": {
      "$ref": "#/$defs/Quantity"
    }
  },
  "required": [
    "name",
    "width",
    "depth",
    "axial_load",
    "concrete_strength"
  ],
  "title": "BasePlate",
  "type": "object",
  "x-anvilate-version": "1.1.0"
}
