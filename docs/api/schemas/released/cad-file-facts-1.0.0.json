{
  "$defs": {
    "CylinderFacts": {
      "additionalProperties": false,
      "description": "One round feature: every cylindrical face about one axis at one radius, as one feature.\n\nA hole modelled as two half-cylinders is one hole. A ``hole`` or a ``boss`` goes all\nthe way round its axis. A ``fillet`` (concave) or a ``round`` (convex) covers part of\nthe turn: a plate's rounded corner, the end of a slot, an inside corner radius.\n``position_mm`` is the middle of the feature on its axis, and ``depth_mm`` its extent\nalong it.",
      "properties": {
        "axis": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Axis",
          "type": "array"
        },
        "depth_mm": {
          "minimum": 0,
          "title": "Depth Mm",
          "type": "number"
        },
        "diameter_mm": {
          "exclusiveMinimum": 0,
          "title": "Diameter Mm",
          "type": "number"
        },
        "kind": {
          "enum": [
            "hole",
            "boss",
            "fillet",
            "round"
          ],
          "title": "Kind",
          "type": "string"
        },
        "position_mm": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position Mm",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "diameter_mm",
        "depth_mm",
        "axis",
        "position_mm"
      ],
      "title": "CylinderFacts",
      "type": "object"
    },
    "DimensionFacts": {
      "additionalProperties": false,
      "description": "One dimension entity: what its geometry measures, and what its text says instead.",
      "properties": {
        "disagrees": {
          "default": false,
          "title": "Disagrees",
          "type": "boolean"
        },
        "layer": {
          "title": "Layer",
          "type": "string"
        },
        "measured_mm": {
          "title": "Measured Mm",
          "type": "number"
        },
        "override": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Override"
        }
      },
      "required": [
        "layer",
        "measured_mm"
      ],
      "title": "DimensionFacts",
      "type": "object"
    },
    "HolePatternFacts": {
      "additionalProperties": false,
      "description": "Several equal holes on parallel axes: how many, how far apart, and their circle.",
      "properties": {
        "axis": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Axis",
          "type": "array"
        },
        "bolt_circle_diameter_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bolt Circle Diameter Mm"
        },
        "count": {
          "minimum": 2,
          "title": "Count",
          "type": "integer"
        },
        "diameter_mm": {
          "exclusiveMinimum": 0,
          "title": "Diameter Mm",
          "type": "number"
        },
        "pitch_mm": {
          "exclusiveMinimum": 0,
          "title": "Pitch Mm",
          "type": "number"
        }
      },
      "required": [
        "count",
        "diameter_mm",
        "axis",
        "pitch_mm"
      ],
      "title": "HolePatternFacts",
      "type": "object"
    },
    "PlaneFacts": {
      "additionalProperties": false,
      "description": "One planar face: its area and the way it faces.",
      "properties": {
        "area_mm2": {
          "exclusiveMinimum": 0,
          "title": "Area Mm2",
          "type": "number"
        },
        "normal": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Normal",
          "type": "array"
        }
      },
      "required": [
        "area_mm2",
        "normal"
      ],
      "title": "PlaneFacts",
      "type": "object"
    },
    "ProfileFacts": {
      "additionalProperties": false,
      "description": "One outer closed profile of a drawing, with the closed profiles inside it.",
      "properties": {
        "area_mm2": {
          "exclusiveMinimum": 0,
          "title": "Area Mm2",
          "type": "number"
        },
        "height_mm": {
          "exclusiveMinimum": 0,
          "title": "Height Mm",
          "type": "number"
        },
        "holes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProfileHole"
          },
          "title": "Holes",
          "type": "array"
        },
        "holes_not_listed": {
          "default": 0,
          "minimum": 0,
          "title": "Holes Not Listed",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "circle",
            "rectangle",
            "profile"
          ],
          "title": "Kind",
          "type": "string"
        },
        "layer": {
          "title": "Layer",
          "type": "string"
        },
        "width_mm": {
          "exclusiveMinimum": 0,
          "title": "Width Mm",
          "type": "number"
        }
      },
      "required": [
        "layer",
        "kind",
        "width_mm",
        "height_mm",
        "area_mm2"
      ],
      "title": "ProfileFacts",
      "type": "object"
    },
    "ProfileHole": {
      "additionalProperties": false,
      "description": "A closed profile inside another: a circle by its diameter, anything else by its box.",
      "properties": {
        "diameter_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diameter Mm"
        },
        "height_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height Mm"
        },
        "kind": {
          "enum": [
            "circle",
            "profile"
          ],
          "title": "Kind",
          "type": "string"
        },
        "width_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width Mm"
        },
        "x_mm": {
          "title": "X Mm",
          "type": "number"
        },
        "y_mm": {
          "title": "Y Mm",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "x_mm",
        "y_mm"
      ],
      "title": "ProfileHole",
      "type": "object"
    },
    "SolidFacts": {
      "additionalProperties": false,
      "description": "One solid of a STEP file, measured.",
      "properties": {
        "cylinders": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CylinderFacts"
          },
          "title": "Cylinders",
          "type": "array"
        },
        "cylinders_not_listed": {
          "default": 0,
          "minimum": 0,
          "title": "Cylinders Not Listed",
          "type": "integer"
        },
        "faces": {
          "minimum": 1,
          "title": "Faces",
          "type": "integer"
        },
        "hole_patterns": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HolePatternFacts"
          },
          "title": "Hole Patterns",
          "type": "array"
        },
        "planes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PlaneFacts"
          },
          "title": "Planes",
          "type": "array"
        },
        "planes_not_listed": {
          "default": 0,
          "minimum": 0,
          "title": "Planes Not Listed",
          "type": "integer"
        },
        "size_mm": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Size Mm",
          "type": "array"
        },
        "unclassified_faces": {
          "default": 0,
          "minimum": 0,
          "title": "Unclassified Faces",
          "type": "integer"
        },
        "volume_mm3": {
          "exclusiveMinimum": 0,
          "title": "Volume Mm3",
          "type": "number"
        }
      },
      "required": [
        "size_mm",
        "volume_mm3",
        "faces"
      ],
      "title": "SolidFacts",
      "type": "object"
    }
  },
  "$id": "urn:anvilate:schema:cad-file-facts:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Anvilate CAD file facts: what one STEP, DXF, STL or 3MF file holds, measured, in millimetres, with the unit the file was written in and its SHA-256. Solids with their holes and hole patterns, drawing profiles with their holes and dimensions, or a mesh's size and volume. Generated from anvilate.context.CadFacts.",
  "properties": {
    "bytes": {
      "minimum": 0,
      "title": "Bytes",
      "type": "integer"
    },
    "closed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Closed"
    },
    "dimensions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DimensionFacts"
      },
      "title": "Dimensions",
      "type": "array"
    },
    "file": {
      "title": "File",
      "type": "string"
    },
    "kind": {
      "enum": [
        "step",
        "dxf",
        "mesh"
      ],
      "title": "Kind",
      "type": "string"
    },
    "layers": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Layers",
      "type": "array"
    },
    "notes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "open_entities": {
      "default": 0,
      "title": "Open Entities",
      "type": "integer"
    },
    "products": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Products",
      "type": "array"
    },
    "profiles": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProfileFacts"
      },
      "title": "Profiles",
      "type": "array"
    },
    "profiles_not_listed": {
      "default": 0,
      "title": "Profiles Not Listed",
      "type": "integer"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "size_mm": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Size Mm",
      "type": "array"
    },
    "solids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SolidFacts"
      },
      "title": "Solids",
      "type": "array"
    },
    "solids_not_listed": {
      "default": 0,
      "title": "Solids Not Listed",
      "type": "integer"
    },
    "triangles": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Triangles"
    },
    "unit_reported": {
      "enum": [
        "mm",
        "file units"
      ],
      "title": "Unit Reported",
      "type": "string"
    },
    "unit_written": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Unit Written"
    },
    "volume_mm3": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Volume Mm3"
    }
  },
  "required": [
    "file",
    "sha256",
    "bytes",
    "kind",
    "unit_written",
    "unit_reported",
    "size_mm"
  ],
  "title": "CadFacts",
  "type": "object",
  "x-anvilate-version": "1.0.0"
}
