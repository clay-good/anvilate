{
  "$defs": {
    "CircularLocator": {
      "additionalProperties": false,
      "description": "A concentric bore, boss, or counterbore that locates a mating interface.",
      "properties": {
        "axial_extent": {
          "$ref": "#/$defs/Quantity"
        },
        "diameter": {
          "$ref": "#/$defs/Quantity"
        },
        "kind": {
          "enum": [
            "bore",
            "boss",
            "counterbore"
          ],
          "title": "Kind",
          "type": "string"
        },
        "through_diameter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "diameter",
        "axial_extent"
      ],
      "title": "CircularLocator",
      "type": "object"
    },
    "HolePattern": {
      "additionalProperties": false,
      "description": "A bolt/hole pattern published as part of an interface contract.",
      "properties": {
        "diameter": {
          "$ref": "#/$defs/Quantity"
        },
        "hole_centers": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "$ref": "#/$defs/Quantity"
                  },
                  {
                    "$ref": "#/$defs/Quantity"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hole Centers"
        },
        "hole_count": {
          "minimum": 1,
          "title": "Hole Count",
          "type": "integer"
        },
        "hole_size": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "diameter",
        "hole_count",
        "hole_size"
      ],
      "title": "HolePattern",
      "type": "object"
    },
    "InterfaceContract": {
      "additionalProperties": false,
      "description": "A published, importable interface: the geometry a mating part designs against.",
      "properties": {
        "frame": {
          "anyOf": [
            {
              "$ref": "#/$defs/InterfaceFrame"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/CircularLocator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mating_plane": {
          "title": "Mating Plane",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "pattern": {
          "$ref": "#/$defs/HolePattern"
        }
      },
      "required": [
        "name",
        "mating_plane",
        "pattern"
      ],
      "title": "InterfaceContract",
      "type": "object"
    },
    "InterfaceFrame": {
      "additionalProperties": false,
      "description": "A right-handed coordinate frame locating an interface in its source geometry.",
      "properties": {
        "normal": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Normal",
          "type": "array"
        },
        "origin": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "$ref": "#/$defs/Quantity"
            }
          ],
          "title": "Origin",
          "type": "array"
        },
        "x_axis": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "X Axis",
          "type": "array"
        },
        "y_axis": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Y Axis",
          "type": "array"
        }
      },
      "required": [
        "origin",
        "x_axis",
        "y_axis",
        "normal"
      ],
      "title": "InterfaceFrame",
      "type": "object"
    },
    "Quantity": {
      "description": "A physical value: a magnitude and the unit it was expressed in.\n\nConstruct directly (``Quantity(magnitude=75, unit=\"kip\")``) or parse from\ntext (``Quantity.parse(\"75 kip\")``). The stored ``unit`` string is exactly\nwhat the user wrote, canonicalized only to Pint's spelling of it.",
      "properties": {
        "magnitude": {
          "title": "Magnitude",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "magnitude",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    }
  },
  "$id": "https://anvilate.dev/schemas/confirmed-step-interface/1.4.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Anvilate confirmed STEP interface: the source digest and exact measured candidate IDs, the named person who accepted them, and the InterfaceContract created for downstream design. Generated from anvilate.geometry.ConfirmedStepInterface.",
  "properties": {
    "confirmed_by": {
      "title": "Confirmed By",
      "type": "string"
    },
    "contract": {
      "$ref": "#/$defs/InterfaceContract"
    },
    "face_candidate_id": {
      "title": "Face Candidate Id",
      "type": "string"
    },
    "pattern_candidate_id": {
      "title": "Pattern Candidate Id",
      "type": "string"
    },
    "solid_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Solid Id"
    },
    "source_name": {
      "title": "Source Name",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    }
  },
  "required": [
    "source_name",
    "source_sha256",
    "face_candidate_id",
    "pattern_candidate_id",
    "confirmed_by",
    "contract"
  ],
  "title": "ConfirmedStepInterface",
  "type": "object",
  "x-anvilate-version": "1.4.0"
}
