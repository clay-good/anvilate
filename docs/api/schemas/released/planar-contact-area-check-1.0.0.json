{
  "$defs": {
    "ConfirmedPlanarContact": {
      "description": "One exact planar contact candidate accepted by a named person.",
      "properties": {
        "confirmed_by": {
          "title": "Confirmed By",
          "type": "string"
        },
        "contact_candidate_id": {
          "title": "Contact Candidate Id",
          "type": "string"
        },
        "first_face_candidate_id": {
          "title": "First Face Candidate Id",
          "type": "string"
        },
        "first_solid_id": {
          "title": "First Solid Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "overlap_area_mm2": {
          "exclusiveMinimum": 0,
          "title": "Overlap Area Mm2",
          "type": "number"
        },
        "second_face_candidate_id": {
          "title": "Second Face Candidate Id",
          "type": "string"
        },
        "second_solid_id": {
          "title": "Second Solid Id",
          "type": "string"
        },
        "source_name": {
          "title": "Source Name",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "source_name",
        "source_sha256",
        "contact_candidate_id",
        "name",
        "first_solid_id",
        "first_face_candidate_id",
        "second_solid_id",
        "second_face_candidate_id",
        "overlap_area_mm2",
        "confirmed_by"
      ],
      "title": "ConfirmedPlanarContact",
      "type": "object"
    }
  },
  "$id": "https://anvilate.dev/schemas/planar-contact-area-check/1.0.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Anvilate planar contact area check: one confirmed contact checked against a caller-supplied minimum overlap area, with margin, pass/fail status, and the requirement citation. Generated from anvilate.geometry.PlanarContactAreaCheck.",
  "properties": {
    "confirmed_contact": {
      "$ref": "#/$defs/ConfirmedPlanarContact"
    },
    "margin_above_minimum_mm2": {
      "title": "Margin Above Minimum Mm2",
      "type": "number"
    },
    "minimum_overlap_area_mm2": {
      "minimum": 0,
      "title": "Minimum Overlap Area Mm2",
      "type": "number"
    },
    "reference": {
      "title": "Reference",
      "type": "string"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "confirmed_contact",
    "minimum_overlap_area_mm2",
    "margin_above_minimum_mm2",
    "status",
    "reference"
  ],
  "title": "PlanarContactAreaCheck",
  "type": "object",
  "x-anvilate-version": "1.0.0"
}
