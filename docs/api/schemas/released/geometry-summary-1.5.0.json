{
  "$defs": {
    "FeatureSummary": {
      "description": "One cut feature of a built part: what it is, how big, and where.",
      "properties": {
        "depthMm": {
          "exclusiveMinimum": 0,
          "title": "Depthmm",
          "type": "number"
        },
        "diameterMm": {
          "exclusiveMinimum": 0,
          "title": "Diametermm",
          "type": "number"
        },
        "kind": {
          "enum": [
            "through_hole",
            "blind_hole",
            "counterbore",
            "countersink",
            "slot"
          ],
          "title": "Kind",
          "type": "string"
        },
        "positionMm": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Positionmm",
          "type": "array"
        },
        "tag": {
          "title": "Tag",
          "type": "string"
        },
        "thread": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thread"
        }
      },
      "required": [
        "tag",
        "kind",
        "diameterMm",
        "depthMm",
        "positionMm"
      ],
      "title": "FeatureSummary",
      "type": "object"
    }
  },
  "$id": "urn:anvilate:schema:geometry-summary:1.5.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Anvilate geometry summary: the audited pattern, declared dimensions, semantic face tags, and kernel-checked volume for one valid solid. Generated from anvilate.geometry.GeometrySummary.",
  "properties": {
    "dimensionsMm": {
      "additionalProperties": {
        "exclusiveMinimum": 0,
        "type": "number"
      },
      "title": "Dimensionsmm",
      "type": "object"
    },
    "envelope": {
      "default": false,
      "title": "Envelope",
      "type": "boolean"
    },
    "faceTags": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Facetags",
      "type": "array"
    },
    "features": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FeatureSummary"
      },
      "title": "Features",
      "type": "array"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "pattern": {
      "pattern": "^[a-z][a-z0-9_]*/[0-9]+$",
      "title": "Pattern",
      "type": "string"
    },
    "valid": {
      "const": true,
      "title": "Valid",
      "type": "boolean"
    },
    "volumeMm3": {
      "exclusiveMinimum": 0,
      "title": "Volumemm3",
      "type": "number"
    }
  },
  "required": [
    "name",
    "pattern",
    "valid",
    "volumeMm3",
    "dimensionsMm",
    "faceTags"
  ],
  "title": "GeometrySummary",
  "type": "object",
  "x-anvilate-version": "1.5.0"
}
