    "Quantity": {
      "description": "A physical value: a magnitude and the unit it was expressed in.\n\nConstruct directly (``Quantity(magnitude=75, unit=\"kip\")``) or parse from\ntext (``Quantity.parse(\"75 kip\")``). The stored ``unit`` string is exactly\nwhat the user wrote, canonicalized only to Pint's spelling of it.",
      "properties": {
        "magnitude": {
          "title": "Magnitude",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "magnitude",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "ScreeningDepth": {
      "description": "How deep a document asks to be screened, defined by what each depth screens.\n\n``CONCEPT`` screens the part itself and what it is made of: the element's own pack\nchecks, the references they resolve, the loads and their combination, and the bounds the\ndocument states. ``DETAILED`` adds the work that only makes sense once the drawing\nexists — the toleranced dimensions against the process floor, the stack-up chains, the\ngeometric tolerances, and the interfaces this part publishes.\n\nThe default is ``DETAILED``: screening everything the document supports is what this\nlibrary did before a depth could be declared, and it is the conservative answer. A\ndocument declaring ``CONCEPT`` gets a shorter card whose deferred checks are reported\nas :attr:`~anvilate.scorecard.CheckStatus.OUT_OF_DEPTH` and counted, never as passes.",
      "enum": [
        "concept",
        "detailed"
      ],
      "title": "ScreeningDepth",
      "type": "string"
    },
    "StandardComponentInterface": {
      "additionalProperties": false,
      "description": "An interface to a standard component, referenced by database ID.",
      "properties": {
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/InterfaceKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mating_material": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaterialRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "tag": {
          "title": "Tag",
          "type": "string"
        },
        "type": {
          "const": "standard_component",
          "default": "standard_component",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "tag"
      ],
      "title": "StandardComponentInterface",
      "type": "object"
    },
    "SymmetricTolerance": {
      "additionalProperties": false,
      "description": "A symmetric ± tolerance, e.g. ``±0.1 mm``.",
      "properties": {
        "plus_minus": {
          "$ref": "#/$defs/Quantity"
        },
        "type": {
          "const": "symmetric",
          "default": "symmetric",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "plus_minus"
      ],
      "title": "SymmetricTolerance",
      "type": "object"
    },
    "ToleranceDimension": {
      "additionalProperties": false,
      "description": "An explicitly-toleranced dimension declared on the spec.\n\n``tolerance`` is the typed :data:`~anvilate.tolerance.Tolerance` union —\nsymmetric ±, asymmetric limits, or an ISO 286 fit — and overrides the general\nclass for the feature at ``tag``. :meth:`resolve` yields the common\n:class:`~anvilate.tolerance.ResolvedTolerance` band the drawing, DFM, and\nstack-up layers read.",
      "properties": {
        "nominal": {
          "$ref": "#/$defs/Quantity"
        },
        "tag": {
          "title": "Tag",
          "type": "string"
        },
        "tolerance": {
          "discriminator": {
            "mapping": {
              "fit": "#/$defs/FitTolerance",
              "limits": "#/$defs/LimitTolerance",
              "symmetric": "#/$defs/SymmetricTolerance"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/SymmetricTolerance"
            },
            {
              "$ref": "#/$defs/LimitTolerance"
            },
            {
              "$ref": "#/$defs/FitTolerance"
            }
          ],
          "title": "Tolerance"
        }
      },
      "required": [
        "tag",
        "nominal",
        "tolerance"
      ],
      "title": "ToleranceDimension",
      "type": "object"
    },
    "UnitSystem": {
      "description": "The unit system a spec is authored and reported in.",
      "enum": [
        "SI",
        "US"
      ],
      "title": "UnitSystem",
      "type": "string"
    },
    "ValidationTier": {
      "enum": [
        "T0_geometry",
        "T1_analytical",
        "T2_dfm",
        "T3_fea"
      ],
      "title": "ValidationTier",
      "type": "string"
    }
  },
  "$id": "https://anvilate.dev/schemas/design-spec/1.13.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Anvilate Design Spec IR: the typed, versioned description of a part that the screening pipeline consumes. Generated from anvilate.spec.DesignSpec.",
  "properties": {
    "acceptance": {
      "$ref": "#/$defs/AcceptanceCriteria"
    },
    "anvilate_spec": {
      "default": "1.13.0",
      "title": "Anvilate Spec",
      "type": "string"
    },
    "budgets": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Budget"
      },
      "title": "Budgets",
      "type": "array"
    },
    "chains": {
      "items": {
        "$ref": "#/$defs/DimensionChain"
      },
      "title": "Chains",
      "type": "array"
    },
    "combination_basis": {
      "anyOf": [
        {
          "enum": [
            "asce7_lrfd",
            "asce7_asd",
            "asce7_lrfd_seismic",
            "asce7_asd_seismic"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Combination Basis"
    },
    "constraints": {
      "$ref": "#/$defs/Constraints"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "dimensions": {
      "items": {
        "$ref": "#/$defs/ToleranceDimension"
      },
      "title": "Dimensions",
      "type": "array"
    },
    "element_params": {
      "additionalProperties": true,
      "title": "Element Params",
      "type": "object"
    },
    "element_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Element Type"
    },
    "environment": {
      "anyOf": [
        {
          "$ref": "#/$defs/Environment"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "exports": {
      "items": {
        "$ref": "#/$defs/InterfaceContract"
      },
      "title": "Exports",
      "type": "array"
    },
    "geometric_tolerances": {
      "items": {
        "$ref": "#/$defs/GeometricTolerance"
      },
      "title": "Geometric Tolerances",
      "type": "array"
    },
    "interfaces": {
      "items": {
        "discriminator": {
          "mapping": {
            "imported": "#/$defs/ImportedInterface",
            "standard_component": "#/$defs/StandardComponentInterface"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/StandardComponentInterface"
          },
          {
            "$ref": "#/$defs/ImportedInterface"
          }
        ]
      },
      "title": "Interfaces",
      "type": "array"
    },
    "load_cases": {
      "items": {
        "$ref": "#/$defs/LoadCase"
      },
      "title": "Load Cases",
      "type": "array"
    },
    "manufacturing": {
      "$ref": "#/$defs/Manufacturing"
    },
    "material": {
      "$ref": "#/$defs/MaterialRef"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "seismic_design_acceleration": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seismic Design Acceleration"
    },
    "seismic_redundancy_factor": {
      "default": 1.0,
      "exclusiveMinimum": 0,
      "title": "Seismic Redundancy Factor",
      "type": "number"
    },
    "units": {
      "$ref": "#/$defs/Provenanced_UnitSystem_"
    }
  },
  "required": [
    "name",
    "description",
    "units",
    "material",
    "manufacturing",
    "acceptance"
  ],
  "title": "DesignSpec",
  "type": "object",
  "x-anvilate-version": "1.13.0"
}
