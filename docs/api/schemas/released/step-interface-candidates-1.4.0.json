{
  "$defs": {
    "CircularFeatureCandidate": {
      "description": "One concentric bore, boss, or counterbore that can locate a mating interface.",
      "properties": {
        "axial_extent_mm": {
          "exclusiveMinimum": 0,
          "title": "Axial Extent Mm",
          "type": "number"
        },
        "center_mm": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Center Mm",
          "type": "array"
        },
        "diameter_mm": {
          "exclusiveMinimum": 0,
          "title": "Diameter Mm",
          "type": "number"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "bore",
            "boss",
            "counterbore"
          ],
          "title": "Kind",
          "type": "string"
        },
        "through_diameter_mm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Through Diameter Mm"
        }
      },
      "required": [
        "id",
        "kind",
        "diameter_mm",
        "axial_extent_mm",
        "center_mm"
      ],
      "title": "CircularFeatureCandidate",
      "type": "object"
    },
    "HolePatternCandidate": {
      "description": "One equal-diameter through-hole pattern measured on a planar STEP face.",
      "properties": {
        "center_mm": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Center Mm",
          "type": "array"
        },
        "hole_centers_mm": {
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 2,
          "title": "Hole Centers Mm",
          "type": "array"
        },
        "hole_count": {
          "minimum": 2,
          "title": "Hole Count",
          "type": "integer"
        },
        "hole_diameter_mm": {
          "exclusiveMinimum": 0,
          "title": "Hole Diameter Mm",
          "type": "number"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "pitch_diameter_mm": {
          "exclusiveMinimum": 0,
          "title": "Pitch Diameter Mm",
          "type": "number"
        }
      },
      "required": [
        "id",
        "hole_count",
        "hole_diameter_mm",
        "pitch_diameter_mm",
        "center_mm",
        "hole_centers_mm"
      ],
      "title": "HolePatternCandidate",
      "type": "object"
    },
    "PlanarInterfaceCandidate": {
      "description": "One planar mating-face candidate and any through-hole patterns it carries.",
      "properties": {
        "area_mm2": {
          "exclusiveMinimum": 0,
          "title": "Area Mm2",
          "type": "number"
        },
        "center_mm": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Center Mm",
          "type": "array"
        },
        "hole_patterns": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HolePatternCandidate"
          },
          "title": "Hole Patterns",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "locating_features": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CircularFeatureCandidate"
          },
          "title": "Locating Features",
          "type": "array"
        },
        "normal": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Normal",
          "type": "array"
        },
        "solid_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Solid Id"
        }
      },
      "required": [
        "id",
        "area_mm2",
        "center_mm",
        "normal"
      ],
      "title": "PlanarInterfaceCandidate",
      "type": "object"
    },
    "StepSolidCandidate": {
      "description": "One imported solid identified by deterministic measured geometry.",
      "properties": {
        "bounds_max_mm": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bounds Max Mm",
          "type": "array"
        },
        "bounds_min_mm": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bounds Min Mm",
          "type": "array"
        },
        "center_mm": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Center Mm",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "volume_mm3": {
          "exclusiveMinimum": 0,
          "title": "Volume Mm3",
          "type": "number"
        }
      },
      "required": [
        "id",
        "volume_mm3",
        "center_mm",
        "bounds_min_mm",
        "bounds_max_mm"
      ],
      "title": "StepSolidCandidate",
      "type": "object"
    }
  },
  "$id": "https://anvilate.dev/schemas/step-interface-candidates/1.4.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Anvilate STEP interface candidates: planar mating faces and regular equal-diameter through-hole patterns and concentric locating features measured from imported solids, with identity and measured solid summaries on multi-solid inputs. Candidates require user confirmation before becoming interface contracts. Generated from anvilate.geometry.StepInterfaceCandidates.",
  "properties": {
    "planar_faces": {
      "items": {
        "$ref": "#/$defs/PlanarInterfaceCandidate"
      },
      "title": "Planar Faces",
      "type": "array"
    },
    "solids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StepSolidCandidate"
      },
      "title": "Solids",
      "type": "array"
    },
    "source_name": {
      "title": "Source Name",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "source_name",
    "source_sha256",
    "planar_faces"
  ],
  "title": "StepInterfaceCandidates",
  "type": "object",
  "x-anvilate-version": "1.4.0"
}
