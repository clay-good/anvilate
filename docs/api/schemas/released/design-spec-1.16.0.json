      },
      "title": "Dimensions",
      "type": "array"
    },
    "element_params": {
      "additionalProperties": true,
      "title": "Element Params",
      "type": "object"
    },
    "element_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Element Type"
