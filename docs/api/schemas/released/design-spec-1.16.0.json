{
  "$defs": {
    "AcceptanceCriteria": {
      "additionalProperties": false,
      "description": "Which checks must run and the thresholds they are judged against.",
      "properties": {
        "depth": {
          "$ref": "#/$defs/ScreeningDepth",
          "default": "detailed"
        },
        "fea_convergence_tol": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fea Convergence Tol"
        },
        "max_displacement": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tiers": {
          "items": {
            "$ref": "#/$defs/ValidationTier"
          },
          "minItems": 1,
          "title": "Tiers",
          "type": "array"
        }
      },
      "required": [
        "tiers"
      ],
      "title": "AcceptanceCriteria",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "description": "An allocated limit on one quantity, and the terms that spend it.",
      "properties": {
        "contributors": {
          "items": {
            "$ref": "#/$defs/Contributor"
          },
          "minItems": 1,
          "title": "Contributors",
          "type": "array"
        },
        "growth": {
          "default": [],
          "items": {
            "$ref": "#/$defs/GrowthAllowance"
          },
          "title": "Growth",
          "type": "array"
        },
        "limit": {
          "$ref": "#/$defs/Quantity"
        },
        "limit_basis": {
          "$ref": "#/$defs/LimitBasis"
        },
        "limit_source": {
          "title": "Limit Source",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "quantity": {
          "title": "Quantity",
          "type": "string"
        },
        "rule": {
          "anyOf": [
            {
              "$ref": "#/$defs/CombinationRule"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "quantity",
        "limit",
        "limit_basis",
        "limit_source",
        "rule",
        "contributors"
      ],
      "title": "Budget",
      "type": "object"
    },
    "ChainLink": {
      "additionalProperties": false,
      "description": "One dimension in a stack-up chain, referenced by its tag.\n\n``direction`` is ``+1`` when the dimension growing widens the resulting gap\nand ``-1`` when it narrows it.",
      "properties": {
        "dimension": {
          "title": "Dimension",
          "type": "string"
        },
        "direction": {
          "default": 1,
          "enum": [
            1,
            -1
          ],
          "title": "Direction",
          "type": "integer"
        }
      },
      "required": [
        "dimension"
      ],
      "title": "ChainLink",
      "type": "object"
    },
    "CircularLocator": {
      "additionalProperties": false,
      "description": "A concentric bore, boss, or counterbore that locates a mating interface.",
      "properties": {
        "axial_extent": {
          "$ref": "#/$defs/Quantity"
        },
        "diameter": {
          "$ref": "#/$defs/Quantity"
        },
        "kind": {
          "enum": [
            "bore",
            "boss",
            "counterbore"
          ],
          "title": "Kind",
          "type": "string"
        },
        "through_diameter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "diameter",
        "axial_extent"
      ],
      "title": "CircularLocator",
      "type": "object"
    },
    "CombinationRule": {
      "description": "How contributors combine. Declared by the author; there is no default.",
      "enum": [
        "worst_case",
        "rss",
        "hybrid"
      ],
      "title": "CombinationRule",
      "type": "string"
    },
    "Constraint": {
      "additionalProperties": false,
      "description": "One interface: the feature it acts at, its kind, and the freedoms it removes.",
      "properties": {
        "feature": {
          "title": "Feature",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ConstraintKind"
        },
        "redundancy": {
          "anyOf": [
            {
              "$ref": "#/$defs/IntentionalRedundancy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "removes": {
          "items": {
            "$ref": "#/$defs/Freedom"
          },
          "minItems": 1,
          "title": "Removes",
          "type": "array"
        }
      },
      "required": [
        "feature",
        "kind",
        "removes"
      ],
      "title": "Constraint",
      "type": "object"
    },
    "ConstraintDeclaration": {
      "additionalProperties": false,
      "description": "How the part is located: each interface constraining it, counted in a named frame.\n\nEvery constraint's ``feature`` is a tag the document already carries — an interface, a\ntoleranced dimension or a controlled feature — so a change in how a part is located\nshows in the diff as a change to this list, not only as moved hole geometry.",
      "properties": {
        "constraints": {
          "items": {
            "$ref": "#/$defs/Constraint"
          },
          "minItems": 1,
          "title": "Constraints",
          "type": "array"
        },
        "frame": {
          "$ref": "#/$defs/Frame"
        },
        "intended": {
          "default": [],
          "items": {
            "$ref": "#/$defs/IntendedFreedom"
          },
          "title": "Intended",
          "type": "array"
        }
      },
      "required": [
        "frame",
        "constraints"
      ],
      "title": "ConstraintDeclaration",
      "type": "object"
    },
    "ConstraintKind": {
      "description": "The common interfaces, each removing a fixed number of freedoms.",
      "enum": [
        "planar_face",
        "pin_in_hole",
        "slot",
        "ball_in_vee",
        "ball_in_cone",
        "flat_contact",
        "bonded",
        "flexure_blade"
      ],
      "title": "ConstraintKind",
      "type": "string"
    },
    "Constraints": {
      "additionalProperties": false,
      "description": "Bounds the design must satisfy.",
      "properties": {
        "envelope": {
          "anyOf": [
            {
              "$ref": "#/$defs/Envelope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "margins": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MarginEntry"
          },
          "title": "Margins",
          "type": "array"
        },
        "max_cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenanced_float_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_mass": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenanced_Annotated_Quantity__AfterValidator__"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_safety_factor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenanced_float_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "min_safety_factor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenanced_float_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Constraints",
      "type": "object"
    },
    "Contributor": {
      "additionalProperties": false,
      "description": "One term in a budget.\n\n``value`` is ``None`` when the term's source produced nothing — its check did not run, its\nmeasurement was not supplied — and ``unresolved`` then says why. ``check`` is the id of\nthe scorecard check the value came from, when it came from one; it is the identity double\ncounting is detected on. ``compensating`` declares a deliberate term of opposite sign.\n\n``sub_budget`` makes the term another budget, evaluated under its OWN rule and entering\nthis one as a single value — the way a system allocation decomposes into subsystem\nallocations. A term states exactly one of the three: a value, a reason it has none, or a\nsub-budget.",
      "properties": {
        "basis": {
          "$ref": "#/$defs/ContributorBasis"
        },
        "check": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Check"
        },
        "compensating": {
          "default": false,
          "title": "Compensating",
          "type": "boolean"
        },
        "correlation_group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Group"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "sub_budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/Budget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unresolved": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unresolved"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "value",
        "source",
        "basis"
      ],
      "title": "Contributor",
      "type": "object"
    },
    "ContributorBasis": {
      "description": "How a contributor's value is known — an estimate grows, a measurement does not.",
      "enum": [
        "measured",
        "calculated",
        "estimated"
      ],
      "title": "ContributorBasis",
      "type": "string"
    },
    "CylinderKeepout": {
      "additionalProperties": false,
      "description": "A cylinder of protected space: a connector's mating bore, a shaft's swept radius.",
      "properties": {
        "diameter": {
          "$ref": "#/$defs/Quantity"
        },
        "height": {
          "$ref": "#/$defs/Quantity"
        },
        "rule": {
          "const": "cylinder",
          "default": "cylinder",
          "title": "Rule",
          "type": "string"
        }
      },
      "required": [
        "diameter",
        "height"
      ],
      "title": "CylinderKeepout",
      "type": "object"
    },
    "DimensionChain": {
      "additionalProperties": false,
      "description": "A user-declared 1D stack-up chain and the clearance it must hold.\n\nThe chain names dimensions (by tag) and sums their directed sizes into a gap\nthat must land within ``required_min``..``required_max``. :meth:`build`\nresolves it against the spec's dimensions into a\n:class:`~anvilate.tolerance.StackUp` for worst-case / RSS analysis.",
      "properties": {
        "links": {
          "items": {
            "$ref": "#/$defs/ChainLink"
          },
          "minItems": 1,
          "title": "Links",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "required_max": {
          "$ref": "#/$defs/Quantity"
        },
        "required_min": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "name",
        "links",
        "required_min",
        "required_max"
      ],
      "title": "DimensionChain",
      "type": "object"
    },
    "Envelope": {
      "additionalProperties": false,
      "description": "A bounding-box constraint.",
      "properties": {
        "x": {
          "$ref": "#/$defs/Quantity"
        },
        "y": {
          "$ref": "#/$defs/Quantity"
        },
        "z": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "title": "Envelope",
      "type": "object"
    },
    "Environment": {
      "description": "What the part lives in, where that changes which failure modes apply.\n\nA closed vocabulary rather than free text, because a catalogue that matched prose would\nfire on the wording of a description. Absent means the document does not say, which is\nnever read as \"benign\": a mode keyed on an environment nobody declared does not apply,\nand the coverage report states that the document could not say.",
      "enum": [
        "indoor_dry",
        "outdoor_sheltered",
        "marine",
        "thermal_cycling",
        "vibration",
        "submerged"
      ],
      "title": "Environment",
      "type": "string"
    },
    "FitTolerance": {
      "additionalProperties": false,
      "description": "An ISO 286 fit designation for a single feature, e.g. ``H7`` or ``g6``.",
      "properties": {
        "designation": {
          "title": "Designation",
          "type": "string"
        },
        "type": {
          "const": "fit",
          "default": "fit",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "designation"
      ],
      "title": "FitTolerance",
      "type": "object"
    },
    "Frame": {
      "additionalProperties": false,
      "description": "The frame the six freedoms are counted in, each axis described in words.\n\nA tally is meaningless without one: \"rotation about z\" is actionable only when z is\n\"the bore axis\". The descriptions are what every rendering names a freedom against.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "string"
        },
        "y": {
          "title": "Y",
          "type": "string"
        },
        "z": {
          "title": "Z",
          "type": "string"
        }
      },
      "required": [
        "name",
        "x",
        "y",
        "z"
      ],
      "title": "Frame",
      "type": "object"
    },
    "Freedom": {
      "description": "One of a rigid body's six degrees of freedom, in a declared frame.",
      "enum": [
        "tx",
        "ty",
        "tz",
        "rx",
        "ry",
        "rz"
      ],
      "title": "Freedom",
      "type": "string"
    },
    "FrustumKeepout": {
      "additionalProperties": false,
      "description": "A cone or frustum: a beam converging to a focus, a tool's approach cone.\n\n``top_diameter`` may be zero, which is a cone, but not both ends: a frustum with no\nbase and no top has no volume.",
      "properties": {
        "base_diameter": {
          "$ref": "#/$defs/Quantity"
        },
        "height": {
          "$ref": "#/$defs/Quantity"
        },
        "rule": {
          "const": "frustum",
          "default": "frustum",
          "title": "Rule",
          "type": "string"
        },
        "top_diameter": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "base_diameter",
        "top_diameter",
        "height"
      ],
      "title": "FrustumKeepout",
      "type": "object"
    },
    "GeometricCharacteristic": {
      "description": "The geometric characteristics this slice supports (ISO 1101 / ASME Y14.5).",
      "enum": [
        "flatness",
        "straightness",
        "circularity",
        "cylindricity",
        "perpendicularity",
        "parallelism",
        "angularity",
        "position",
        "circular_runout",
        "total_runout"
      ],
      "title": "GeometricCharacteristic",
      "type": "string"
    },
    "GeometricTolerance": {
      "additionalProperties": false,
      "description": "A geometric tolerance (GD&T feature control frame) on a tagged feature.\n\n``tolerance`` is the tolerance-zone width, or its diameter when ``diametral``\n(the ⌀ modifier, used for a hole axis under a position control). ``feature``\nis the semantic tag the control applies to; ``datums`` are the ordered datum\nreferences (primary, secondary, tertiary). Whether a ``feature`` or ``datum``\ntag names a real geometry feature is checked by the tag-graph layer, not here.",
      "properties": {
        "characteristic": {
          "$ref": "#/$defs/GeometricCharacteristic"
        },
        "datums": {
          "items": {
            "type": "string"
          },
          "title": "Datums",
          "type": "array"
        },
        "diametral": {
          "default": false,
          "title": "Diametral",
          "type": "boolean"
        },
        "feature": {
          "title": "Feature",
          "type": "string"
        },
        "tolerance": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "characteristic",
        "tolerance",
        "feature"
      ],
      "title": "GeometricTolerance",
      "type": "object"
    },
    "GrowthAllowance": {
      "additionalProperties": false,
      "description": "A factor applied to every contributor of one basis, and the authority for it.\n\nEstablished practice: an estimated quantity is expected to grow more than a measured one.\nThe allowance is applied to the contributor's value AND recorded as a margin-ledger entry\nof kind contingency-or-growth, so it is visible as conservatism rather than absorbed into\na number that then looks like a measurement.",
      "properties": {
        "authority": {
          "title": "Authority",
          "type": "string"
        },
        "basis": {
          "$ref": "#/$defs/ContributorBasis"
        },
        "factor": {
          "title": "Factor",
          "type": "number"
        }
      },
      "required": [
        "basis",
        "factor",
        "authority"
      ],
      "title": "GrowthAllowance",
      "type": "object"
    },
    "HolePattern": {
      "additionalProperties": false,
      "description": "A bolt/hole pattern published as part of an interface contract.",
      "properties": {
        "diameter": {
          "$ref": "#/$defs/Quantity"
        },
        "hole_centers": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "$ref": "#/$defs/Quantity"
                  },
                  {
                    "$ref": "#/$defs/Quantity"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hole Centers"
        },
        "hole_count": {
          "minimum": 1,
          "title": "Hole Count",
          "type": "integer"
        },
        "hole_size": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "diameter",
        "hole_count",
        "hole_size"
      ],
      "title": "HolePattern",
      "type": "object"
    },
    "ImportedBodyKeepout": {
      "additionalProperties": false,
      "description": "A body another tool generated, named by its source and the digest of its file.\n\n``volume`` is the body's own, as its tool reported it, and must be positive for the\nsame reason every other rule's extents must be.",
      "properties": {
        "rule": {
          "const": "imported_body",
          "default": "imported_body",
          "title": "Rule",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "volume": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "source",
        "sha256",
        "volume"
      ],
      "title": "ImportedBodyKeepout",
      "type": "object"
    },
    "ImportedInterface": {
      "additionalProperties": false,
      "description": "An interface imported from another spec's published contract.",
      "properties": {
        "contract": {
          "title": "Contract",
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/InterfaceKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mating_material": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaterialRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_spec": {
          "title": "Source Spec",
          "type": "string"
        },
        "tag": {
          "title": "Tag",
          "type": "string"
        },
        "type": {
          "const": "imported",
          "default": "imported",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "source_spec",
        "contract",
        "tag"
      ],
      "title": "ImportedInterface",
      "type": "object"
    },
    "IntendedFreedom": {
      "additionalProperties": false,
      "description": "A freedom the body keeps on purpose — an adjustment axis, a thermal slide.",
      "properties": {
        "freedom": {
          "$ref": "#/$defs/Freedom"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        }
      },
      "required": [
        "freedom",
        "purpose"
      ],
      "title": "IntendedFreedom",
      "type": "object"
    },
    "IntentionalRedundancy": {
      "additionalProperties": false,
      "description": "A redundancy declared on purpose: why, and what makes it tolerable.",
      "properties": {
        "justification": {
          "title": "Justification",
          "type": "string"
        },
        "mechanism": {
          "$ref": "#/$defs/RedundancyMechanism"
        }
      },
      "required": [
        "justification",
        "mechanism"
      ],
      "title": "IntentionalRedundancy",
      "type": "object"
    },
    "InterfaceContract": {
      "additionalProperties": false,
      "description": "A published, importable interface: the geometry a mating part designs against.",
      "properties": {
        "frame": {
          "anyOf": [
            {
              "$ref": "#/$defs/InterfaceFrame"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/CircularLocator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mating_plane": {
          "title": "Mating Plane",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "pattern": {
          "$ref": "#/$defs/HolePattern"
        }
      },
      "required": [
        "name",
        "mating_plane",
        "pattern"
      ],
      "title": "InterfaceContract",
      "type": "object"
    },
    "InterfaceFrame": {
      "additionalProperties": false,
      "description": "A right-handed coordinate frame locating an interface in its source geometry.",
      "properties": {
        "normal": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Normal",
          "type": "array"
        },
        "origin": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "$ref": "#/$defs/Quantity"
            }
          ],
          "title": "Origin",
          "type": "array"
        },
        "x_axis": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "X Axis",
          "type": "array"
        },
        "y_axis": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Y Axis",
          "type": "array"
        }
      },
      "required": [
        "origin",
        "x_axis",
        "y_axis",
        "normal"
      ],
      "title": "InterfaceFrame",
      "type": "object"
    },
    "InterfaceKind": {
      "description": "What kind of joint an interface is, for the checks and modes that turn on it.\n\nA ``tag`` names the *feature* an interface produces (``motor_pilot_bore``); it says\nnothing about how the two parts are held together, and a failure mode like fretting or\nself-loosening applies to the joint and not to the feature. This is the closed\nvocabulary that distinction needs.",
      "enum": [
        "bolted_face",
        "clamped",
        "welded",
        "bonded",
        "press_fit",
        "sliding"
      ],
      "title": "InterfaceKind",
      "type": "string"
    },
    "Keepout": {
      "additionalProperties": false,
      "description": "A volume the part must leave empty, why, and what it moves with.\n\n``anchor`` is the tag or datum the keepout is positioned against, so it moves when that\nfeature moves; a keepout fixed in absolute space would stop protecting the right region\nthe moment the feature it exists for moved, and its check would keep passing. The\n``reason`` is required, because a protected volume nobody can explain cannot be weighed\nagainst a change that wants the space. ``clearance_margin`` is a band around the\nprotected core: material inside it warns, material in the core fails. ``owner`` is who\ndeclared it, the user or a named module.\n\nThe body sits centred on the anchor face with its axis along the face's inward normal,\nits near end ``offset`` from the face measured into the part: zero starts it on the face,\na negative offset starts it in front of the face, outside the part.",
      "properties": {
        "anchor": {
          "title": "Anchor",
          "type": "string"
        },
        "clearance_margin": {
          "$ref": "#/$defs/Quantity"
        },
        "offset": {
          "$ref": "#/$defs/Quantity"
        },
        "owner": {
          "default": "user",
          "title": "Owner",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "rule": {
          "discriminator": {
            "mapping": {
              "cylinder": "#/$defs/CylinderKeepout",
              "frustum": "#/$defs/FrustumKeepout",
              "imported_body": "#/$defs/ImportedBodyKeepout",
              "prism": "#/$defs/PrismKeepout",
              "swept_profile": "#/$defs/SweptProfileKeepout"
            },
            "propertyName": "rule"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PrismKeepout"
            },
            {
              "$ref": "#/$defs/CylinderKeepout"
            },
            {
              "$ref": "#/$defs/FrustumKeepout"
            },
            {
              "$ref": "#/$defs/SweptProfileKeepout"
            },
            {
              "$ref": "#/$defs/ImportedBodyKeepout"
            }
          ],
          "title": "Rule"
        },
        "tag": {
          "title": "Tag",
          "type": "string"
        }
      },
      "required": [
        "tag",
        "anchor",
        "rule",
        "clearance_margin",
        "reason"
      ],
      "title": "Keepout",
      "type": "object"
    },
    "LimitBasis": {
      "description": "Where an allocated limit came from.",
      "enum": [
        "requirement",
        "derived_allocation",
        "working_assumption"
      ],
      "title": "LimitBasis",
      "type": "string"
    },
    "LimitTolerance": {
      "additionalProperties": false,
      "description": "An asymmetric tolerance given as signed upper/lower limit deviations.",
      "properties": {
        "lower": {
          "$ref": "#/$defs/Quantity"
        },
        "type": {
          "const": "limits",
          "default": "limits",
          "title": "Type",
          "type": "string"
