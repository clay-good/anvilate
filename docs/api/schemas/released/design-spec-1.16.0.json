    "MarginAction": {
      "description": "The direction a factor moves the result — both are conservative.",
      "enum": [
        "raises_demand",
        "lowers_capacity"
      ],
      "title": "MarginAction",
      "type": "string"
    },
    "MarginEntry": {
      "additionalProperties": false,
      "description": "One conservatism applied to one quantity, attributed.\n\n``value`` is the factor as a multiplier of conservatism: 1.5 means the demand was raised,\nor the capacity lowered, by 1.5. A value below 1 would be *un*-conservative and is not a\nmargin; exactly 1 is recorded honestly as a factor that moved nothing.",
      "properties": {
        "action": {
          "$ref": "#/$defs/MarginAction"
        },
        "authority": {
          "title": "Authority",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MarginKind"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "origin": {
          "title": "Origin",
          "type": "string"
        },
        "quantity": {
          "title": "Quantity",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "label",
        "kind",
        "value",
        "quantity",
        "action",
        "origin",
        "authority"
      ],
      "title": "MarginEntry",
      "type": "object"
    },
    "MarginKind": {
      "description": "Why a factor is there. Obligation and choice are different evidence.",
      "enum": [
        "code_required",
        "user_elected",
        "statistical_basis",
