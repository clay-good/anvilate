        }
      },
      "required": [
        "upper",
        "lower"
      ],
      "title": "LimitTolerance",
      "type": "object"
    },
    "LoadCase": {
      "additionalProperties": false,
      "description": "A single load condition the part must survive.\n\nEach ``kind`` carries its own magnitude: a ``static`` or ``quasi_static`` case\na ``force`` (quasi-static also a ``quasi_static_factor`` that scales it), a\n``remote_mass`` case an offset ``remote_mass``. A case missing its magnitude is\nrejected at construction — a downstream analysis can never be handed a load\nwith nothing to apply.\n\n``nature`` optionally classifies the case by its ASCE 7 load nature (dead, live,\nwind, seismic, …) so a declared combination set can factor it. It is orthogonal\nto ``kind`` (which is how the load is applied) and defaults to ``None`` — a spec\nthat does not use load combinations leaves it unset.",
      "properties": {
        "applied_to": {
          "title": "Applied To",
          "type": "string"
        },
        "force": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "$ref": "#/$defs/LoadKind"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "nature": {
          "anyOf": [
            {
              "$ref": "#/$defs/LoadNature"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quasi_static_factor": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quasi Static Factor"
        },
        "remote_mass": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "kind",
        "applied_to"
      ],
      "title": "LoadCase",
      "type": "object"
    },
    "LoadKind": {
      "enum": [
        "static",
        "quasi_static",
        "remote_mass"
      ],
      "title": "LoadKind",
      "type": "string"
    },
    "LoadNature": {
      "description": "The nature of a load case, by its ASCE 7 symbol.\n\nThe factor a combination applies depends on the load's nature, not its name —\ndead load is always factored as dead load. Seismic (``E``) carries the\nhorizontal earthquake effect ρ·Q_E; the vertical part folds into the dead factor.",
      "enum": [
        "D",
        "L",
        "Lr",
        "S",
        "R",
        "W",
        "E"
      ],
      "title": "LoadNature",
      "type": "string"
    },
    "Manufacturing": {
      "additionalProperties": false,
      "description": "The manufacturing process and the DFM parameters it is checked against.",
      "properties": {
        "min_wall": {
          "anyOf": [
