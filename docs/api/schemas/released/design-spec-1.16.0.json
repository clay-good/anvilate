          "type": "string"
        }
      },
      "required": [
        "ref",
        "tag"
      ],
      "title": "StandardComponentInterface",
      "type": "object"
    },
    "SweptProfileKeepout": {
      "additionalProperties": false,
      "description": "A rectangular section swept along a straight path: a service-access corridor.",
